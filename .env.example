# ==============================================================================
# Kirmya Platform - Master Environment Configuration Template
# Tech Stack: Next.js (TypeScript / MUI v6) | Golang (Gin) | PostgreSQL | Redis
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' for local development:
#    cp .env.example .env
# 2. Never commit actual secret keys or private credentials to version control.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION METADATA & GLOBALS
# ==============================================================================
APP_NAME="Kirmya AI Career Companion"
APP_ENV="development" # Options: development, staging, production
APP_VERSION="2.1.0"
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8080"
API_URL="http://localhost:8080/api/v1"
SITE_TITLE="Kirmya | AI Career Assistance & Professional Network"
TIMEZONE="UTC"
DEFAULT_LOCALE="en"

# ==============================================================================
# 2. FRONTEND CONFIGURATION (NEXT.JS - NEXT_PUBLIC_)
# ==============================================================================
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CDN_URL="http://localhost:3000/assets"
NEXT_PUBLIC_ASSETS_URL="http://localhost:3000/assets"
NEXT_PUBLIC_UPLOAD_URL="http://localhost:8080/uploads"
NEXT_PUBLIC_ENV="development"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_MAINTENANCE_MODE="false"
NEXT_PUBLIC_COOKIE_CONSENT_VERSION="v1.0"

# ==============================================================================
# 3. BACKEND SERVER CONFIGURATION (GOLANG GIN)
# ==============================================================================
SERVER_HOST="0.0.0.0"
SERVER_PORT="8080"
API_PREFIX="/api/v1"
READ_TIMEOUT="15s"
WRITE_TIMEOUT="15s"
IDLE_TIMEOUT="60s"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
TRUSTED_PROXIES="127.0.0.1,::1"
MAX_REQUEST_BODY_SIZE="10485760" # 10MB in bytes
UPLOAD_DIR="./uploads"
TEMP_DIR="./tmp"

# ==============================================================================
# 4. AUTHENTICATION & SECURITY TOKENS
# ==============================================================================
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_ISSUER="kirmya-auth-service"
JWT_AUDIENCE="kirmya-clients"
JWT_EXPIRATION="24h"
REFRESH_TOKEN_EXPIRATION="168h" # 7 days
PASSWORD_RESET_EXPIRATION="1h"
EMAIL_VERIFICATION_EXPIRATION="24h"
SESSION_SECRET="your-super-secret-session-key-min-32-chars"
SESSION_EXPIRATION="72h"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false" # Set 'true' in production
COOKIE_SAME_SITE="Lax" # Options: Lax, Strict, None

# ==============================================================================
# 5. DATABASE CONFIGURATION (POSTGRESQL & READ REPLICAS)
# ==============================================================================
# Single Connection String (Used by Railway, Heroku, Supabase, Cloud DBs)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kirmya?sslmode=disable"

# Individual Connection Parameters
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_USER="postgres"
DATABASE_PASSWORD="your-postgres-password"
DATABASE_NAME="kirmya"
DATABASE_SSLMODE="disable" # Options: disable, require, verify-full
DATABASE_TIMEZONE="UTC"
DATABASE_POOL_SIZE="25"
DATABASE_MAX_OPEN_CONNS="50"
DATABASE_MAX_IDLE_CONNS="10"
DATABASE_CONN_MAX_LIFETIME="30m"
DATABASE_MIGRATION_PATH="./scripts/migrations"

# Read Replicas (Optional - Fallback to Primary if empty)
DATABASE_REPLICA_URL_1=""
DATABASE_REPLICA_URL_2=""

# ==============================================================================
# 6. REDIS CLUSTER & CACHING (OPTIONAL - FALLBACK TO IN-MEMORY CACHE)
# ==============================================================================
REDIS_URL="redis://localhost:6379/0"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
REDIS_TLS_ENABLED="false"
# Note: If Redis is unavailable, Kirmya automatically degrades to in-memory caching.

# ==============================================================================
# 7. NATS MESSAGING BROKER (OPTIONAL - FALLBACK TO IN-PROCESS EVENT BUS)
# ==============================================================================
NATS_URL="nats://localhost:4222"
NATS_CLUSTER_ID="kirmya-cluster"
NATS_CLIENT_NAME="kirmya-backend"
NATS_TOKEN=""
NATS_RECONNECT_ATTEMPTS="5"
# Note: If NATS is unconfigured, Kirmya uses an in-process goroutine EventBus.

# ==============================================================================
# 8. OPENSEARCH / ELASTICSEARCH (OPTIONAL - FALLBACK TO POSTGRES FULL-TEXT)
# ==============================================================================
OPENSEARCH_ENDPOINT="http://localhost:9200"
OPENSEARCH_USER="admin"
OPENSEARCH_PASSWORD="your-opensearch-password"
OPENSEARCH_INDEX="kirmya-jobs"
OPENSEARCH_SSL="false"
# Note: If OpenSearch is unconfigured, Kirmya defaults to PostgreSQL GIN full-text.

# ==============================================================================
# 9. OPENTELEMETRY DISTRIBUTED TRACING (OPTIONAL)
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_SERVICE_NAME="kirmya-backend"
OTEL_SERVICE_VERSION="2.1.0"
OTEL_SAMPLING_RATIO="1.0"
OTEL_EXPORTER_TYPE="otlp" # Options: otlp, jaeger, stdout, none
# Note: Tracing automatically degrades without errors if collector is offline.

# ==============================================================================
# 10. EMAIL / SMTP NOTIFICATION SERVICES
# ==============================================================================
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_SENDER_EMAIL="noreply@kirmya.com"
SMTP_SENDER_NAME="Kirmya Notifications"
SMTP_ENCRYPTION="tls" # Options: tls, ssl, none
SMTP_REPLY_TO="support@kirmya.com"

# ==============================================================================
# 11. FILE & ASSET UPLOADS
# ==============================================================================
MAX_UPLOAD_SIZE="10485760" # 10MB
ALLOWED_FILE_EXTENSIONS=".pdf,.doc,.docx,.png,.jpg,.jpeg"
ALLOWED_IMAGE_TYPES="image/png,image/jpeg,image/webp"
MAX_IMAGE_SIZE="5242880" # 5MB
MAX_AVATAR_SIZE="2097152" # 2MB
MAX_RESUME_SIZE="5242880" # 5MB
MAX_DOCUMENT_SIZE="10485760" # 10MB

# ==============================================================================
# 12. CLOUDFLARE EDGE CDN CONFIGURATION
# ==============================================================================
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_CDN_URL="https://cdn.kirmya.dev"
CLOUDFLARE_CACHE_TTL="14400" # 4 hours

# ==============================================================================
# 13. RAILWAY DEPLOYMENT SPECIFICS
# ==============================================================================
RAILWAY_ENVIRONMENT="production"
RAILWAY_HEALTHCHECK_PATH="/api/v1/health"

# ==============================================================================
# 14. VERCEL FRONTEND DEPLOYMENT SPECIFICS
# ==============================================================================
VERCEL_ENV="production"
VERCEL_URL="kirmya-frontend.vercel.app"

# ==============================================================================
# 15. ENTERPRISE SECURITY & ENCRYPTION
# ==============================================================================
CSRF_SECRET="your-super-secret-csrf-key-min-32-chars"
ENCRYPTION_KEY="your-32-byte-aes-256-encryption-key!"
RATE_LIMIT_RPM="60"
RATE_LIMIT_BURST="10"
ALLOWED_HOSTS="localhost,127.0.0.1,kirmya.com,*.kirmya.com"
HSTS_ENABLED="false" # Set 'true' in production

# ==============================================================================
# 16. LOGGING & DEBUGGING
# ==============================================================================
LOG_LEVEL="info" # Options: debug, info, warn, error
LOG_FORMAT="json" # Options: json, text
LOG_OUTPUT="stdout" # Options: stdout, stderr, file
DEBUG="true"

# ==============================================================================
# 17. FEATURE FLAGS & TOGGLES
# ==============================================================================
FEATURE_COMMUNITIES="true"
FEATURE_MESSAGING="true"
FEATURE_NOTIFICATIONS="true"
FEATURE_AI_ASSISTANT="true"
FEATURE_SEARCH="true"
FEATURE_REFERRALS="true"
FEATURE_ADMIN_DASHBOARD="true"
FEATURE_MAINTENANCE="false"
FEATURE_REGISTRATION="true"
FEATURE_EMAIL_VERIFICATION="true"

# ==============================================================================
# 18. RATE LIMITING & SECURITY THROTTLING
# ==============================================================================
RATE_LIMIT_LOGIN_ATTEMPTS="5"
RATE_LIMIT_PASSWORD_RESET="3"
RATE_LIMIT_OTP="3"

# ==============================================================================
# 19. COOKIE POLICY & CONSENT
# ==============================================================================
COOKIE_NAME="kirmya_session"
COOKIE_CONSENT_VERSION="v1.0"

# ==============================================================================
# 20. SEARCH ENGINE PROVIDER
# ==============================================================================
DEFAULT_SEARCH_PROVIDER="postgres" # Options: postgres, opensearch
SEARCH_INDEX="kirmya_global_jobs"
SEARCH_CACHE_DURATION="15m"

# ==============================================================================
# 21. MONITORING & METRICS EXPOSITION
# ==============================================================================
HEALTH_CHECK_PATH="/api/v1/health"
METRICS_PATH="/api/v1/metrics"
ENABLE_PROMETHEUS="true"
ENABLE_TRACING="true"

# ==============================================================================
# 22. DOCKER COMPOSE DEPLOYMENT OVERRIDES
# ==============================================================================
COMPOSE_PROJECT_NAME="kirmya"
