# Kirmya Environment Example File
NODE_ENV=development

# APP_ENV drives every environment-dependent default in the Go API, including
# the refresh cookie's Secure flag. Use development locally, test in CI and
# production in production — leaving it unset is treated as development.
APP_ENV=development

# Server Ports
PORT=8080
FRONTEND_PORT=3000

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_SECRET=your_jwt_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars

# PostgreSQL Database Configuration
POSTGRES_DB=kirmya_db
POSTGRES_USER=kirmya_user
POSTGRES_PASSWORD=kirmya_pass
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://kirmya_user:kirmya_pass@localhost:5432/kirmya_db?sslmode=disable
# ALLOW_NO_DB=false

# Redis Caching Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3-compatible / MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=kirmya-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/kirmya-uploads
# Local disk fallback when STORAGE_ENDPOINT is unset:
# UPLOAD_DIRECTORY=./uploads

# Email (SMTP / Mailhog for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kirmya.com
SMTP_FROM_NAME="Kirmya Notifications"
SMTP_REPLY_TO=support@kirmya.com
SMTP_ENCRYPTION=none
# Alternative: Resend HTTPS API (takes precedence over SMTP if key is set)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@kirmya.com

# Session & Refresh Cookie
#
# The refresh token lives in an HttpOnly cookie; the access token lives only in
# the browser tab's memory. Never put either in localStorage or sessionStorage.
#
# AUTH_COOKIE_SECURE must be false for local development, because the API is
# served over plain HTTP and WebKit silently refuses to store a Secure cookie on
# an insecure origin — the session then cannot survive a reload, and the failure
# looks exactly like a bug in the app. It is forced back to true in production
# regardless of what is set here.
#
# SameSite=Lax is correct for kirmya.com talking to api.kirmya.com: they share a
# registrable domain, so the request is already same-site. Use none (which
# requires Secure) only when the web client is genuinely served from a different
# site than the API.
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Leave AUTH_COOKIE_DOMAIN unset for a host-only cookie, which is what you want.
# Setting .kirmya.com would share the cookie with every subdomain, including any
# that is ever hosted by a third party.
# AUTH_COOKIE_DOMAIN=

# Go duration strings. The access token is short-lived by design: it cannot be
# revoked before it expires, so its lifetime is the window an already-issued
# token stays usable after a session is ended.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
REMEMBER_ME_REFRESH_TOKEN_TTL=720h

# Rate limits. The session endpoints (/auth/refresh, /auth/me, /auth/session,
# /auth/logout) sit on their own bucket, separate from the credential endpoints:
# every page load costs two session requests, so sharing the credential
# allowance signs users out when they reload.
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_BURST=120
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_BURST=5
AUTH_SESSION_RATE_LIMIT_REQUESTS=120
AUTH_SESSION_RATE_LIMIT_BURST=60
NEWSLETTER_RATE_LIMIT_REQUESTS=10
NEWSLETTER_RATE_LIMIT_BURST=5
TRUSTED_PROXIES=127.0.0.1,::1

# Search (PostgreSQL full-text by default; OpenSearch optional via profile)
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200

# AI Provider (deterministic fallback when unset; no provider configured)
AI_PROVIDER=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Billing & Payments (disabled - free platform promise)
BILLING_ENABLED=false
STRIPE_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
CHECKOUT_ENABLED=false
PREMIUM_FEATURES_ENABLED=false
BILLING_WEBHOOK_SECRET=

# Observability, Telemetry & Operator Access
BUILD_SHA=
APP_VERSION=2.1.0
OTEL_ENABLED=false
ENABLE_TRACING=false
METRICS_USERNAME=
METRICS_PASSWORD=
SWAGGER_ENABLED=true
SWAGGER_HOST=localhost:8080
SWAGGER_BASE_PATH=/
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# Public Frontend API Endpoint
#
# Include the /api/v1 prefix. The client normalises a base without it, but the
# versioned form is the documented convention and what the E2E suite asserts.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
