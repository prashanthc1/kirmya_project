# Kirmya Environment Example File
NODE_ENV=development

# Server Ports
PORT=8080
FRONTEND_PORT=3000

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_SECRET=your_jwt_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars

# PostgreSQL Database Configuration
POSTGRES_DB=kirmya_db
POSTGRES_USER=kirmya_user
POSTGRES_PASSWORD=kirmya_pass
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://kirmya_user:kirmya_pass@localhost:5432/kirmya_db?sslmode=disable

# Redis Caching Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Public Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8080
