# ==============================================================================
# Kirmya Frontend (Next.js) - Master Environment Template
# Tech Stack: Next.js (TypeScript) | React | Material UI v6
# ==============================================================================
# Instructions:
# 1. Copy this file to 'frontend/.env' for local development:
#    cp frontend/.env.example frontend/.env
# 2. All client-side variables MUST start with NEXT_PUBLIC_
# 3. Never commit actual secret keys to version control.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION METADATA
# ==============================================================================
NEXT_PUBLIC_APP_NAME="Kirmya AI Career Companion"
NEXT_PUBLIC_APP_ENV="development" # Options: development, staging, production
NEXT_PUBLIC_APP_VERSION="2.1.0"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"
NEXT_PUBLIC_SITE_TITLE="Kirmya | AI Career Assistance & Professional Network"
NEXT_PUBLIC_DEFAULT_LANGUAGE="en"
NEXT_PUBLIC_DEFAULT_TIMEZONE="UTC"

# ==============================================================================
# 2. BRANDING & ASSETS
# ==============================================================================
NEXT_PUBLIC_COMPANY_NAME="Kirmya Technologies Inc."
NEXT_PUBLIC_LOGO_URL="/assets/logo.png"
NEXT_PUBLIC_FAVICON_URL="/favicon.ico"

# ==============================================================================
# 3. AUTHENTICATION & SESSIONS
# ==============================================================================
NEXT_PUBLIC_AUTH_PROVIDER="jwt" # Options: jwt, oauth2, custom
NEXT_PUBLIC_SESSION_TIMEOUT="86400" # 24 hours in seconds
NEXT_PUBLIC_COOKIE_CONSENT_VERSION="v1.0"

# ==============================================================================
# 4. FEATURE FLAGS & TOGGLES
# ==============================================================================
NEXT_PUBLIC_ENABLE_COMMUNITIES="true"
NEXT_PUBLIC_ENABLE_MESSAGING="true"
NEXT_PUBLIC_ENABLE_NOTIFICATIONS="true"
NEXT_PUBLIC_ENABLE_REFERRALS="true"
NEXT_PUBLIC_ENABLE_AI="true"
NEXT_PUBLIC_ENABLE_SEARCH="true"
NEXT_PUBLIC_ENABLE_ADMIN="true"
NEXT_PUBLIC_ENABLE_PROFILE_COMPLETION="true"
NEXT_PUBLIC_ENABLE_DARK_MODE="true"
NEXT_PUBLIC_ENABLE_LIGHT_MODE="true"
NEXT_PUBLIC_ENABLE_REGISTRATION="true"
NEXT_PUBLIC_ENABLE_EMAIL_VERIFICATION="true"

# ==============================================================================
# 5. ANALYTICS & MONITORING
# ==============================================================================
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# ==============================================================================
# 6. UPLOADS & FILE LIMITS
# ==============================================================================
NEXT_PUBLIC_MAX_AVATAR_SIZE="2097152" # 2MB in bytes
NEXT_PUBLIC_MAX_RESUME_SIZE="5242880" # 5MB in bytes
NEXT_PUBLIC_ALLOWED_IMAGE_TYPES="image/png,image/jpeg,image/webp"
NEXT_PUBLIC_ALLOWED_DOCUMENT_TYPES=".pdf,.doc,.docx"

# ==============================================================================
# 7. CDN & STATIC ASSETS
# ==============================================================================
NEXT_PUBLIC_CDN_URL="http://localhost:3000/assets"
NEXT_PUBLIC_ASSETS_URL="http://localhost:3000/assets"

# ==============================================================================
# 8. CLOUDFLARE IMAGES & CDN
# ==============================================================================
NEXT_PUBLIC_CLOUDFLARE_IMAGE_URL="https://imagedelivery.net/your-account-hash"

# ==============================================================================
# 9. COOKIE POLICY & DOMAIN
# ==============================================================================
NEXT_PUBLIC_COOKIE_DOMAIN="localhost"
NEXT_PUBLIC_COOKIE_SECURE="false" # Set 'true' in production
NEXT_PUBLIC_COOKIE_SAMESITE="Lax" # Options: Lax, Strict, None

# ==============================================================================
# 10. UI & THEME CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_DEFAULT_THEME="dark" # Options: dark, light, system
NEXT_PUBLIC_ENABLE_GLASSMORPHISM="true"
NEXT_PUBLIC_ENABLE_ANIMATIONS="true"

# ==============================================================================
# 11. SEARCH PROVIDER
# ==============================================================================
NEXT_PUBLIC_SEARCH_PROVIDER="postgres" # Options: postgres, opensearch

# ==============================================================================
# 12. MAINTENANCE MODE
# ==============================================================================
NEXT_PUBLIC_MAINTENANCE_MODE="false"
