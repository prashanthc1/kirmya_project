# ==============================================================================
# Kirmya Backend (Golang Gin) - Master Environment Template
# Tech Stack: Golang (Gin Framework) | PostgreSQL | Redis | OpenTelemetry
# ==============================================================================
# Instructions:
# 1. Copy this file to 'backend/.env' for local development:
#    cp backend/.env.example backend/.env
# 2. Never commit actual secret keys or private credentials to version control.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION METADATA
# ==============================================================================
APP_NAME="Kirmya AI Career Companion"
APP_ENV="development" # Options: development, staging, production
APP_VERSION="2.1.0"
APP_URL="http://localhost:8080"
SERVER_HOST="0.0.0.0"
SERVER_PORT="8080"
API_PREFIX="/api/v1"
TIMEZONE="UTC"
DEFAULT_LANGUAGE="en"

# ==============================================================================
# 2. SERVER PERFORMANCE & TIMEOUTS
# ==============================================================================
READ_TIMEOUT="15s"
WRITE_TIMEOUT="15s"
IDLE_TIMEOUT="60s"
MAX_REQUEST_SIZE="10485760" # 10MB in bytes
# Proxy addresses (IPs or CIDRs) whose X-Forwarded-For may be believed when
# deriving the client IP for rate limiting. Unset trusts none and every request
# is keyed on the socket peer. Behind a platform load balancer with a floating
# edge address (Railway, Heroku, Fly) set "*" to trust all hops — otherwise the
# limiter sees only the proxy IP and throttles every user as one client.
TRUSTED_PROXIES="127.0.0.1,::1"
# Browser origins allowed to call the API with credentials. Comma-separated and
# matched exactly (scheme, host and port), because the API answers credentialed
# requests and a wildcard would be rejected by the browser. Falls back to
# ALLOWED_ORIGINS then FRONTEND_URL; outside production it defaults to the local
# Next.js dev server. Production allows nothing unless one of these is set.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ==============================================================================
# 3. DATABASE CONFIGURATION (POSTGRESQL & READ REPLICAS)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kirmya?sslmode=disable"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="kirmya"
DB_USER="postgres"
DB_PASSWORD="your-postgres-password"
DB_SSLMODE="disable" # Options: disable, require, verify-full
DB_TIMEZONE="UTC"
DB_MAX_OPEN_CONNECTIONS="50"
DB_MAX_IDLE_CONNECTIONS="10"
DB_CONNECTION_LIFETIME="30m"

# ==============================================================================
# 4. JWT AUTHENTICATION TOKENS
# ==============================================================================
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars-long"
JWT_ISSUER="kirmya-auth-service"
JWT_AUDIENCE="kirmya-clients"
JWT_ACCESS_TOKEN_EXPIRATION="24h"
JWT_REFRESH_TOKEN_EXPIRATION="168h" # 7 days

# ==============================================================================
# 5. SESSIONS & COOKIE SECURITY
# ==============================================================================
COOKIE_DOMAIN="localhost"
SESSION_SECRET="your-super-secret-session-key-min-32-chars"
SESSION_COOKIE_NAME="kirmya_session"
SESSION_COOKIE_DOMAIN="localhost"
SESSION_COOKIE_SECURE="false" # Set 'true' in production
SESSION_COOKIE_SAMESITE="Lax" # Options: Lax, Strict, None

# ==============================================================================
# 6. AUTHENTICATION EXPIRATION TIMERS
# ==============================================================================
PASSWORD_RESET_EXPIRATION="1h"
EMAIL_VERIFICATION_EXPIRATION="24h"
OTP_EXPIRATION="10m"

# Onboarding runs before sign-in, so requests without a bearer token are stored
# under the shared demo user 00000000-0000-0000-0000-000000000001. Set to
# "false" to require a real session and reject anonymous onboarding writes.
ONBOARDING_ALLOW_DEMO_USER="true"

# ==============================================================================
# 7. EMAIL / SMTP NOTIFICATIONS
# ==============================================================================
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USERNAME="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="noreply@kirmya.com"
EMAIL_FROM="noreply@kirmya.com"
SMTP_FROM_NAME="Kirmya Notifications"
SMTP_REPLY_TO="support@kirmya.com"
SMTP_ENCRYPTION="tls" # Options: tls, ssl, none

# ==============================================================================
# 8. FILE UPLOADS & ASSET DIRECTORIES
# ==============================================================================
UPLOAD_DIRECTORY="./uploads"
TEMP_DIRECTORY="./tmp"
MAX_UPLOAD_SIZE="10485760" # 10MB
MAX_AVATAR_SIZE="2097152" # 2MB
MAX_RESUME_SIZE="5242880" # 5MB
MAX_DOCUMENT_SIZE="10485760" # 10MB
ALLOWED_IMAGE_TYPES="image/png,image/jpeg,image/webp"
ALLOWED_DOCUMENT_TYPES=".pdf,.doc,.docx"

# ==============================================================================
# 9. REDIS CLUSTER & CACHING (OPTIONAL - FALLBACK TO IN-MEMORY CACHE)
# ==============================================================================
REDIS_ENABLED="true"
REDIS_URL="redis://localhost:6379/0"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DATABASE="0"
# Note: If Redis is disabled/unavailable, Kirmya automatically degrades to in-memory caching.

# ==============================================================================
# 10. NATS MESSAGING BROKER (OPTIONAL - FALLBACK TO IN-PROCESS EVENT BUS)
# ==============================================================================
NATS_ENABLED="false"
NATS_URL="nats://localhost:4222"
NATS_CLUSTER_ID="kirmya-cluster"
NATS_CLIENT_NAME="kirmya-backend"
# Note: If disabled/unconfigured, Kirmya uses an in-process goroutine EventBus.

# ==============================================================================
# 11. OPENSEARCH / ELASTICSEARCH (OPTIONAL - FALLBACK TO POSTGRES FULL-TEXT)
# ==============================================================================
OPENSEARCH_ENABLED="false"
OPENSEARCH_URL="http://localhost:9200"
OPENSEARCH_USERNAME="admin"
OPENSEARCH_PASSWORD="your-opensearch-password"
OPENSEARCH_INDEX="kirmya-jobs"
# Note: If disabled, Kirmya defaults to PostgreSQL GIN full-text indexing.

# ==============================================================================
# 12. OPENTELEMETRY TRACING (OPTIONAL)
# ==============================================================================
OTEL_ENABLED="true"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_SERVICE_NAME="kirmya-backend"
OTEL_SERVICE_VERSION="2.1.0"
OTEL_SAMPLING_RATIO="1.0"
# Note: Tracing automatically degrades without errors if collector is offline.

# ==============================================================================
# 13. SECURITY & ENCRYPTION
# ==============================================================================
ENCRYPTION_KEY="your-32-byte-aes-256-encryption-key!"
CSRF_SECRET="your-super-secret-csrf-key-min-32-chars"
# Global per-client-IP budget applied to every /api/v1 route. REQUESTS is the
# sustained rate per minute; BURST is how many requests may land back to back
# before that rate takes over. Keep BURST comfortably above the number of
# parallel calls one page load fires, or the SPA throttles itself. Set
# RATE_LIMIT_REQUESTS="0" to disable. Sign-in keeps its own stricter limit.
RATE_LIMIT_REQUESTS="600"
RATE_LIMIT_BURST="120"
TRUSTED_HOSTS="localhost,127.0.0.1,kirmya.com,*.kirmya.com"
# Legacy alias for CORS_ALLOWED_ORIGINS; only read when that one is unset.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ==============================================================================
# 14. LOGGING & DEBUGGING
# ==============================================================================
LOG_LEVEL="info" # Options: debug, info, warn, error
LOG_FORMAT="json" # Options: json, text
LOG_OUTPUT="stdout" # Options: stdout, stderr, file
DEBUG="true"

# ==============================================================================
# 15. CLOUDFLARE CDN CONFIGURATION
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# ==============================================================================
# 16. RAILWAY DEPLOYMENT SPECIFICS
# ==============================================================================
RAILWAY_ENVIRONMENT="production"

# ==============================================================================
# 17. DOCKER COMPOSE DEPLOYMENT OVERRIDES
# ==============================================================================
DOCKER_ENVIRONMENT="development"

# ==============================================================================
# 18. HEALTH CHECKS & METRICS EXPOSITION
# ==============================================================================
HEALTH_ENDPOINT="/api/v1/health"
METRICS_ENDPOINT="/api/v1/metrics"
# The metrics endpoint is never public: it exposes request volumes, error rates
# and runtime internals. Set both of these to require basic auth from the
# scraper — needed whenever the scraper reaches the API over the internet.
# Leave them empty and the endpoint answers only callers on loopback or private
# networks (a sidecar scraper); everyone else gets a 404.
METRICS_USERNAME=""
METRICS_PASSWORD=""

# Thirteen modules (assessment, career_ai, career_companion, endorsement,
# global_marketplace, landing, mobile, native_mobile, recommendation_engine,
# referral, resume_analysis, search, verification) keep their data in process
# memory: it is lost on restart and not shared between replicas. The backend
# lists them at startup and, when APP_ENV=production, refuses to boot unless
# this is "true". Setting it accepts the data loss deliberately — implementing
# the storage or unwiring the module is the real fix.
# See docs/decisions/0001-ephemeral-repositories.md.
ALLOW_EPHEMERAL_REPOS="false"

# ==============================================================================
# 19. SWAGGER / OPENAPI DOCUMENTATION
# ==============================================================================
# Serve Swagger UI at /swagger/index.html. Keep this false anywhere the API
# surface should not be published; the routes are not registered when off.
SWAGGER_ENABLED="true"
# Authority Swagger UI issues "Try it out" requests against.
# Development: localhost:8080   Production: api.kirmya.com
SWAGGER_HOST="localhost:8080"
# Prefix applied to every documented path. Routes already carry /api/v1, so
# leave this as "/" unless the service sits behind a path-rewriting proxy.
SWAGGER_BASE_PATH="/"
# Optional. When BOTH are set the docs endpoint sits behind HTTP basic auth.
# Recommended for any internet-facing environment.
SWAGGER_USERNAME=""
SWAGGER_PASSWORD=""

# ==============================================================================
# 20. BILLING & PAYMENT WEBHOOKS
# ==============================================================================
# Kirmya ships with billing off: every feature is free, /billing/checkout
# refuses, and POST /billing/webhooks/:provider records nothing. Turning this on
# activates the paid paths, so read the webhook secret note below before you do.
BILLING_ENABLED="false"
SUBSCRIPTIONS_ENABLED="false"
CHECKOUT_ENABLED="false"
PREMIUM_FEATURES_ENABLED="false"
STRIPE_ENABLED="false"

# Shared secret the payment provider signs its webhook payloads with (Stripe
# calls it the endpoint signing secret, "whsec_..."). The webhook route cannot
# require a login — a provider has no user token — so this HMAC-SHA256 signature
# over the raw request body is the ONLY thing separating a genuine
# "payment succeeded" from anyone on the internet asserting one.
#
# Verification fails closed: with this unset every webhook is rejected with 401.
# That is deliberate. If you set BILLING_ENABLED="true" you must set this too,
# to the value the provider's dashboard shows for that endpoint, or payment
# events will not be recorded.
BILLING_WEBHOOK_SECRET=""
