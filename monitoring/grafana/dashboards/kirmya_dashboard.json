  "panels": [
    {
      "title": "API Request Rate & Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(http_requests_total[5m])", "legendFormat": "Total Requests / sec" },
        { "expr": "rate(http_requests_errors_total[5m])", "legendFormat": "Errors / sec" }
      ]
    },
    {
      "title": "Average API Latency (ms)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "http_request_duration_milliseconds_avg", "legendFormat": "Latency (ms)" }
      ]
    },
    {
      "title": "PostgreSQL Query Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "kirmya_db_query_duration_milliseconds_avg", "legendFormat": "DB Latency (ms)" }
      ]
    },
    {
      "title": "Redis Cache Hit Ratio (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "kirmya_cache_hit_ratio", "legendFormat": "Hit Ratio %" }
      ]
    }
  ],
  "refresh": "5s",
